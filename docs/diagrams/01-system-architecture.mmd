    classDef app fill:#15181d,stroke:#7f8c9b,color:#fff;
    classDef provider fill:#2b2020,stroke:#ff665f,color:#fff;
    class Browser,Desktop client;
    class Web,UI,Agent,Store,OCR app;
    class LLM,CCSwitch provider;
